# Copie este arquivo para tests/e2e/.env. Nunca versione o .env.
# Aponte apenas para uma instância GLPI descartável, com dados fictícios.
E2E_GLPI_BASE_URL=http://localhost:8180

# Perfil interno com VIEW_TECHNICAL, VIEW_OPERATIONAL_HEALTH e
# MANAGE_OPERATIONAL_HEALTH. Não use uma conta administrativa real.
E2E_GLPI_OPERATOR_USER=demandas.e2e.operator
E2E_GLPI_OPERATOR_PASSWORD=troque-esta-senha

# Perfil administrativo fictício com MANAGE_CONFIG, usado apenas para validar
# e capturar a tela de configuração. Pode ser a mesma conta do operador.
E2E_GLPI_ADMIN_USER=demandas.e2e.admin
E2E_GLPI_ADMIN_PASSWORD=troque-esta-senha

# Perfil técnico somente leitura: VIEW_TECHNICAL + VIEW_OPERATIONAL_HEALTH.
E2E_GLPI_VIEWER_USER=demandas.e2e.viewer
E2E_GLPI_VIEWER_PASSWORD=troque-esta-senha

# Perfil sem direitos técnicos nem da central, para validar negação.
E2E_GLPI_RESTRICTED_USER=demandas.e2e.restricted
E2E_GLPI_RESTRICTED_PASSWORD=troque-esta-senha

# Ações mutáveis e capturas para o manual são bloqueadas por padrão.
# Altere E2E_ISOLATED_FIXTURE para 1 somente depois de confirmar que a base é
# descartável e possui somente dados fictícios.
E2E_ISOLATED_FIXTURE=0
E2E_ALLOW_MUTATIONS=0
# Permite salvar screenshots, vídeo e trace. Use somente com dados fictícios.
E2E_ALLOW_ARTIFACTS=0
E2E_UPDATE_MANUAL_SCREENSHOTS=0
